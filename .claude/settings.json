{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run import:guests:*)",
      "Bash(npx vitest:*)",
