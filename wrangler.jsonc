// v3 hosting: docs/DESIGN-v3.md. database_id and ACCESS_* / ALLOWED_EMAILS are filled in at the deploy session.
// Never put DEV_ACCESS_EMAIL here: it lives only in .dev.vars (gitignored); tests/worker.test.ts enforces this.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wedding-planner",
      "database_id": "87b1c95c-7e87-4307-98a3-cac03d0a3937",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "sukursschemper.cloudflareaccess.com",
    "ACCESS_AUD": "15ffbe7d1f46fa9071b240643f11815805be503627df54f9d0b549ff674ed8c0",
    "ALLOWED_EMAILS": "mschemper@gmail.com,angela.sukurs@gmail.com"
  },
  "observability": { "enabled": true }
}
