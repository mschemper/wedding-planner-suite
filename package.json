{
  "name": "wedding-planner-suite",
  "version": "4.0.0",
  "description": "Mark & Angela wedding planning suite: budget studio + guest data layer",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:offline": "vite build --mode offline",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy:dry": "vite build && wrangler deploy --dry-run",
    "check": "npm run typecheck && npm test && vite build && vite build --mode offline",
    "import:v4": "tsx scripts/import-v4.ts",
    "seed:v4": "tsx scripts/seed-v4.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jose": "6.2.13",
    "tsx": "4.20.6",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.9",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
